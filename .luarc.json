{
	"runtime": {
		"version": "LuaJIT",
		"path": ["?.lua", "?/init.lua", "lua/?.lua", "lua/?/init.lua"],
		"pathStrict": true
	},
	"diagnostics": {
		"globals": ["vim", "PREF", "Obsidian"],
		"disable": ["different-requires"]
	},
	"workspace": {
		"library": [
			"$VIMRUNTIME/lua",
			"${3rd}/luv/library"
		],
		"checkThirdParty": false,
		"ignoreDir": [".jj", ".git"]
	},
	"type": {
		"castNumberToInteger": true
	}
}
