#!/usr/bin/env node

// Shared Windows/macOS/Linux/Termux client for lua/jorge/pi_edit_rpc.lua.
const { spawn } = require("node:child_process");
const { randomBytes } = require("node:crypto");
const { chmodSync, mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } = require("node:fs");
const { homedir } = require("node:os");
const { join, resolve } = require("node:path");
const { setTimeout: delay } = require("node:timers/promises");

let requestFile;
let ackFile;
let requestTemp;
let child;

function cleanup() {
  for (const file of [requestFile, ackFile, requestTemp]) {
    if (!file) continue;
    try {
      rmSync(file, { force: true });
    } catch (error) {
      console.error(`pi-nvim-editor: failed to clean up ${file}: ${error.message}`);
    }
  }
}

for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) {
  process.on(signal, () => {
    child?.kill();
    cleanup();
    process.exit(2);
  });
}

function remoteCall(expression) {
  return new Promise((resolveExit) => {
    child = spawn("nvim", ["--headless", "--server", process.env.NVIM, "--remote-expr", expression], {
      stdio: "ignore",
      timeout: 1000,
    });
    child.on("error", () => resolveExit(false));
    child.on("close", (code) => resolveExit(code === 0));
  });
}

function readAck(id) {
  let content;
  try {
    content = readFileSync(ackFile, "utf8");
  } catch (error) {
    if (error.code === "ENOENT") return null;
    throw error;
  }
  const ack = JSON.parse(content);
  if (
    !ack || ack.version !== 1 || ack.id !== id ||
    !["opened", "committed", "aborted", "error"].includes(ack.status)
  ) {
    throw new Error("invalid acknowledgement");
  }
  if (ack.status === "error" && typeof ack.message === "string") {
    console.error(`pi-nvim-editor: ${ack.message}`);
  }
  return ack.status;
}

async function main() {
  const args = process.argv.slice(2);
  let cursorLine = 1;
  if (args.length === 2 && /^\+\d+$/.test(args[0])) {
    cursorLine = Math.max(1, Number(args.shift().slice(1)));
  }
  if (args.length !== 1 || !args[0] || !Number.isSafeInteger(cursorLine)) {
    throw new Error("Usage: pi-nvim-editor [+<line>] <file>");
  }
  const targetPath = resolve(args[0]);

  async function fallbackLocalNvim() {
    cleanup();
    return new Promise((resolveExit, reject) => {
      child = spawn("nvim", [`+${cursorLine}`, "--", targetPath], { stdio: "inherit" });
      child.on("error", reject);
      child.on("close", (code) => resolveExit(code ?? 2));
    });
  }

  if (!process.env.NVIM) return fallbackLocalNvim();

  const stateHome = process.env.XDG_STATE_HOME || join(process.env.HOME || homedir(), ".local", "state");
  const root = join(stateHome, "pi-nvim-rpc");
  const requestsDir = join(root, "requests");
  const acksDir = join(root, "acks");
  for (const dir of [root, requestsDir, acksDir]) {
    mkdirSync(dir, { recursive: true, mode: 0o700 });
    if (process.platform !== "win32") chmodSync(dir, 0o700);
  }
  const createdAtEpochMs = Date.now();
  const id = `pi_${createdAtEpochMs}_${process.pid}_${randomBytes(4).toString("hex")}`;
  requestFile = join(requestsDir, `${id}.json`);
  ackFile = join(acksDir, `${id}.json`);
  requestTemp = join(requestsDir, `.${id}.tmp`);
  writeFileSync(requestTemp, JSON.stringify({
    version: 1,
    id,
    targetPath,
    cursorLine,
    cwd: process.cwd(),
    createdAtEpochMs,
    clientPid: process.pid,
  }), { mode: 0o600, flag: "wx" });
  renameSync(requestTemp, requestFile);

  const finalCodes = { committed: 0, aborted: 1, error: 2 };
  const openDeadline = Date.now() + 3000;
  let dispatched = false;
  let opened = false;
  while (Date.now() < openDeadline) {
    if (!dispatched) {
      dispatched = await remoteCall(`execute('PiEditOpen ${id}')`);
      if (!dispatched && !(await remoteCall("1"))) return fallbackLocalNvim();
    }
    const status = readAck(id);
    if (status === "opened") {
      opened = true;
      break;
    }
    if (status !== null) return finalCodes[status];
    await delay(50);
  }
  if (!opened) return fallbackLocalNvim();

  let nextProbe = Date.now() + 1000;
  let failures = 0;
  while (true) {
    const status = readAck(id);
    if (status !== null && status !== "opened") return finalCodes[status];
    if (Date.now() >= nextProbe) {
      failures = await remoteCall("1") ? 0 : failures + 1;
      if (failures >= 5) throw new Error("Neovim host disconnected before finishing the edit");
      nextProbe = Date.now() + 1000;
    }
    await delay(50);
  }
}

main()
  .then((code) => { process.exitCode = code; })
  .catch((error) => {
    console.error(`pi-nvim-editor: ${error.message}`);
    process.exitCode = 2;
  })
  .finally(cleanup);
